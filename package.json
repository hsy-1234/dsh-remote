{
    "name":  "dsh-remote",
    "version":  "0.0.4",
    "description":  "Remote access manager for the DeepSeek Harness Web UI: LAN + Tailscale status panel, one-click install/login, idempotent patch config.",
    "keywords":  [
                     "deepseek-harness",
                     "dsh",
                     "cordis",
                     "plugin",
                     "tailscale",
                     "remote-access"
                 ],
    "license":  "MIT",
    "main":  "lib/index.js",
    "types":  "lib/index.d.ts",
    "files":  [
                  "lib"
              ],
    "scripts":  {
                    "build":  "tsc -p tsconfig.json \u0026\u0026 node -e \"require(\u0027fs\u0027).copyFileSync(\u0027client/client.js\u0027, \u0027lib/client.js\u0027)\"",
                    "test":  "vitest run",
                    "prepublishOnly":  "npm run build \u0026\u0026 npm test"
                },
    "peerDependencies":  {
                             "@deepseek-ai/cordis":  "^4.0.1"
                         },
    "devDependencies":  {
                            "@deepseek-ai/cordis":  "^4.0.1",
                            "@types/node":  "^22.10.0",
                            "typescript":  "^5.6.0",
                            "vitest":  "^3.0.0"
                        },
    "dependencies":  {
                         "@deepseek-ai/dsh-typert-protocol":  "^0.1.0-rc.6"
                     },
    "exports":  {
                    ".":  {
                              "types":  "./lib/index.d.ts",
                              "default":  "./lib/index.js"
                          },
                    "./remote":  {
                                     "default":  "./lib/remote.js"
                                 },
                    "./client":  {
                                     "default":  "./lib/client.js"
                                 },
                    "./package.json":  "./package.json"
                },
    "dsh":  {
                "client":  {
                               "inject":  [
                                              "@deepseek-ai/dsh-client-runtime",
                                              "@deepseek-ai/dsh-api-remotes"
                                          ],
                               "platform":  "web"
                           }
            },
    "engines":  {
                    "node":  "\u003e=20"
                }
}
